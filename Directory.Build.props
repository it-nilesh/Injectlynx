<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Injectlynx Contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/it-nilesh/Injectlynx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/it-nilesh/Injectlynx</RepositoryUrl>
    <PackageTags>dependency-injection;source-generator;roslyn;compile-time-di;net8;net9;net10;native-aot</PackageTags>
    <PackageReleaseNotes>Supports netstandard2.0, .NET 8, .NET 9, and .NET 10. The source generator is packaged as an analyzer.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
